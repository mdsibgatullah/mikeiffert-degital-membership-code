/* Card Design */
.m-product-card.m-product-card--style-1 {
  position: relative;
  a.m-product-card__link {
    &::after {
      position: absolute;
      content: '';
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 20;
    }
  }
  .m-product-card__main-image {
    &:after, &:before  {
      position: absolute;
      content: '';
      width:100%;
      top: 0;
      left: 0;
      height: 30%;
      background-image: linear-gradient(#2f6293, transparent);
    }
    &:before {
      top: unset;
      bottom: 0;
      background-image: linear-gradient(transparent, #2f6293);
      z-index: 1;
    }
  }
  .m-product-card__action {
    transform: unset;
    opacity: 1;
    product-form.m-product-form{
      z-index: 2;
      form.product-card-form {
        text-align: end;
        button.m-add-to-cart.m-spinner-button {
          background-color: #F68B1F;
          color: #fff;
          &:hover {
            box-shadow: 0 0 0 .2rem #F68B1F;
          }
          .m-button--white {
            &:hover {
              background-color: transparent;
            }
          }
        }
        @media (max-width: 1260px){
          button.m-add-to-cart.m-spinner-button {
            width: 100%;
          }
        }
      }
    }
  }
  .m-product-card__content {
    position: unset;
    .m-product-card__info {
      margin: 0;
      .m-product-card__price,
       h3.m-product-card__title {
        position: absolute;
        width: 100%;
        z-index: 2;
      }
      .m-product-card__price {
        bottom: 75px;  
        left: 50%;
        transform: translateX(-50%);
        text-align: center;
      }
      h3.m-product-card__title {
        display: block;
        top: 20px;
        left: 20px;
        color: #fff;
        font-size: 20px;
        a.m-product-card__name {
          &:hover {
            color: #fff;
          }
        }
      }
      /* .m-product-card__price {
        bottom: 20px;
        left: 20px;
        color: #fff;
        font-weight: bold;
      } */
      /* @media (max-width: 1260px){
        .m-product-card__price {
          bottom: 70px;  
          left: 50%;
          transform: translateX(-50%)
        }
      } */
      .m-price,
      .m-price__regular, 
      .m-price__sale, 
      .m-price__unit-wrapper {
        color: inherit;
      }
      .m-price__sale {
        justify-content: center;
      }
      s.m-price-item.m-price-item--regular.ilm_price_value {
        color: white;
        text-decoration: none;
        font-size: inherit;
        font-size: 24px;
        display: block;
      }
      span.m-price-item.m-price-item--sale.m-price-item--last.ilm_price_price {
        color: #ffc000;
        font-weight: bold;
        font-size: 28px;
        text-shadow: .5px .5px #000000ba;
        display: block;
      }
    }
  }
}

